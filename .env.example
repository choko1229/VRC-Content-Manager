# Copy this file to .env. This project deliberately keeps .env minimal --
# only values needed before the app can even locate its own data or bind a
# port belong here. Everything else (Google OAuth client credentials, the
# optional login password, upload size / Drive sync interval) is configured
# through the app itself: the first-run /setup wizard, and later /settings.
# See README.md "設定" for details.

# Where local state (SQLite cache, instance_config.json, upload temp files)
# lives. Point this at your Pterodactyl persistent volume mount.
DATA_DIR=./data

# Port the app listens on.
PORT=8000

# Optional: DEBUG/INFO/WARNING/ERROR. Needed before any DB read is possible,
# so it can't be made DB-backed like the rest of the operational settings.
LOG_LEVEL=INFO
