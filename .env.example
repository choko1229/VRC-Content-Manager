# Copy this file to .env and fill in real values. Never commit .env.

# --- Google OAuth (create a "Web application" OAuth client in Google Cloud Console) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# --- Secrets ---
# Fernet key used to encrypt the Drive OAuth token at rest in SQLite.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Random secret for signing the session cookie (used by the optional login gate).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# --- Optional application login gate (Phase 6) ---
# If set, all routes except /healthz require this password once per session.
APP_LOGIN_PASSWORD=

# --- Disaster recovery / non-fresh-volume startup ---
# Google Drive file id of the app.db SQLite snapshot. Leave empty on first run;
# the /setup wizard will create it and tell you the id to persist here.
DRIVE_DB_FILE_ID=

# --- Runtime ---
DATA_DIR=./data
PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=500
SYNC_INTERVAL_SECONDS=60
